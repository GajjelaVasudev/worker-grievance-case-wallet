# =============================================================================
# Worker Grievance Case Wallet — Environment Configuration Template
# =============================================================================
# Copy to `.env` ONLY if you want to override defaults or enable cloud AI keys.
# The application boots and loads its main screen via `docker compose up`
# WITHOUT any `.env` file or API keys.
# =============================================================================

# --- Application & Web Port ---
APP_PORT=3000
APP_ENV=development
PUBLIC_DEMO_MODE=false

# --- Database (PostgreSQL 16) ---
# Defaults match docker-compose.yml so zero-.env startup works out of the box.
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=grievance_wallet
DATABASE_URL=postgresql+psycopg://wallet:wallet@db:5432/grievance_wallet

# --- Local Evidence & Audio Storage ---
EVIDENCE_STORAGE_DIR=/data/evidence
MAX_UPLOAD_MB=10
MAX_AUDIO_DURATION_SECONDS=30

# --- Speech-to-Text (ASR) Provider ---
# Supported values: none | sarvam
# Leave ASR_PROVIDER=none or SARVAM_API_KEY empty to run without cloud ASR.
# Verified Sarvam STT model: saaras:v4 (22 Indian languages + English; supports
# webm, wav, mp3, ogg, opus, mp4, m4a, flac, aac; Rs 100 free signup credits,
# Rs 30/hr PAYG).
ASR_PROVIDER=none
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix

# --- Structured Extraction (LLM) Provider ---
# Supported values: none | gemini
# Leave LLM_PROVIDER=none or GEMINI_API_KEY empty to run without cloud LLM.
# Verified Gemini Flash model: gemini-3.8-flash (native JSON Schema / Pydantic
# support; free tier has RPM/RPD caps and inputs may be used for Google
# product improvement; paid tier does not train on customer data).
LLM_PROVIDER=none
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
